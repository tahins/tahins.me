---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, formatDate, isRemoteImage } from '../../lib/blog.js';
import { unsplashSized } from '../../lib/unsplash.js';
import { site } from '../../data/site.js';

const localImages = import.meta.glob('../../assets/blog/**/*.{jpeg,jpg,png,gif,webp}', {
  eager: true,
  import: 'default',
});

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/blog/${post.id.replace(/\.mdx?$/, '')}/`, site.url).href;
const hero = post.data.heroImage;
const heroIsRemote = Boolean(hero && isRemoteImage(hero));

let ogImage;
if (heroIsRemote) {
  ogImage = /images\.unsplash\.com/i.test(hero) ? unsplashSized(hero, 1200) : hero;
} else if (hero && localImages[hero]) {
  const optimized = await getImage({ src: localImages[hero], width: 1200 });
  ogImage = new URL(optimized.src, site.url).href;
}
---

<BaseLayout
  title={`${post.data.title} — ${site.shortName}`}
  description={post.data.description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={post.data.title}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags}
>
  <div class="page-shell">
    <Navbar />
    <article class="blog-post">
      <p class="post-meta">
        <a href="/blog/">blog</a>
        {' / '}
        {formatDate(post.data.pubDate)}
        {post.data.updatedDate && ` · updated ${formatDate(post.data.updatedDate)}`}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <p class="tag-list">
          {post.data.tags.map((tag) => (
            <a href={`/blog/tags/${tag}/`}>#{tag}</a>
          ))}
        </p>
      )}
      <div class="prose">
        <Content />
      </div>
      {post.data.originalUrl && (
        <p class="original-link">
          Originally published on <a href={post.data.originalUrl}>Medium</a>.
        </p>
      )}
    </article>
    <Footer />
  </div>
</BaseLayout>
