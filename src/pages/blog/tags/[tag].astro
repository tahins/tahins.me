---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogChrome from '../../../components/BlogChrome.astro';
import BlogCompactAuthor from '../../../components/BlogCompactAuthor.astro';
import BlogPostList from '../../../components/BlogPostList.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import { getPublishedPosts } from '../../../lib/blog.js';
import { site } from '../../../data/site.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  variant="blog"
  title={`#${tag} — ${site.shortName}`}
  description={`Posts tagged ${tag} on tahins.me`}
  canonical={`${site.url}/blog/tags/${tag}/`}
>
  <BlogChrome>
    <div class="blog-layout">
      <BlogCompactAuthor />
      <main class="blog-feed">
        <p class="post-byline"><a href="/blog/">Blog</a> / tags</p>
        <h1 class="blog-page-title">#{tag}</h1>
        <BlogPostList posts={posts} />
      </main>
      <BlogSidebar />
    </div>
  </BlogChrome>
</BaseLayout>
