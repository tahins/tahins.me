---
import { navLinks, site } from '../data/site.js';
---

<div class="navbar">
  <div class="left">
    <a href="/" class="brand">{site.shortName}</a>
  </div>
  <div class="right">
    <ul class="nav-links">
      {navLinks.map((navLink) => (
        <li>
          <a href={navLink.url}>{navLink.text}</a>
        </li>
      ))}
    </ul>
  </div>
</div>
