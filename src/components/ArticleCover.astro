---
import { Picture } from 'astro:assets';
import UnsplashCredit from './UnsplashCredit.astro';
import { isUnsplashImage, previewSource } from '../lib/blog.js';
import { localBlogImage } from '../lib/blog-images.js';
import { unsplashSized, unsplashSrcset } from '../lib/unsplash.js';

const { post } = Astro.props;
const source = previewSource(post);
const unsplash = source && isUnsplashImage(source);
const local = source ? localBlogImage(source) : null;
const alt = post.data.title;
const credit = post.data.heroImageCredit;
---

{(unsplash || local) && (
  <figure class="article-cover">
    {unsplash && (
      <img
        src={unsplashSized(source, 800)}
        srcset={unsplashSrcset(source, [400, 800, 1200])}
        sizes="(max-width: 680px) 100vw, 680px"
        alt={alt}
        loading="eager"
        decoding="async"
      />
    )}
    {local && (
      <Picture
        src={local}
        alt={alt}
        widths={[400, 680, 800, 1200]}
        sizes="(max-width: 680px) 100vw, 680px"
        formats={['webp']}
        loading="eager"
        decoding="async"
      />
    )}
    {credit && unsplash && (
      <figcaption>
        <UnsplashCredit credit={credit} />
      </figcaption>
    )}
  </figure>
)}
