---
import PostPreviewThumb from './PostPreviewThumb.astro';
import { formatDate, postPath, readingLabel } from '../lib/blog.js';

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <div class="post-copy">
        <h2 class="post-title">
          <a class="post-stretched" href={postPath(post)}>{post.data.title}</a>
        </h2>
        {post.data.description && <p class="post-subtitle">{post.data.description}</p>}
        <p class="post-byline">
          {formatDate(post.data.pubDate)}
          {' · '}
          {readingLabel(post.body)}
        </p>
      </div>
      <PostPreviewThumb post={post} />
    </li>
  ))}
</ul>
