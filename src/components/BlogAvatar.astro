---
import { Picture } from 'astro:assets';
import portrait from '../assets/me.webp';

const { size = 88 } = Astro.props;
---

<div class="blog-avatar" style={`width:${size}px;height:${size}px`}>
  <Picture
    src={portrait}
    alt="Portrait of E. M. Yeaseenur Rahman Tahin"
    widths={[size, size * 2]}
    sizes={`${size}px`}
    width={size}
    formats={['webp']}
    loading="lazy"
    decoding="async"
  />
</div>
